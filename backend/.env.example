# ============================================================
# SecureDrop Cloud — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# Server Configuration
NODE_ENV=development
PORT=5001

# CORS Origin — set to your Vercel frontend URL in production
# e.g. https://your-app-name.vercel.app
CORS_ORIGIN=http://localhost:5173

# ============================================================
# REQUIRED: MongoDB Atlas Connection String
# Create a free cluster at https://cloud.mongodb.com
# Format: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/<dbname>?retryWrites=true&w=majority
# ============================================================
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/file_exchange?retryWrites=true&w=majority&appName=Cluster0

# Storage Driver
# 'gridfs' = store files in MongoDB GridFS (recommended for Vercel & cloud deployments)
STORAGE_DRIVER=gridfs

# Security
# IMPORTANT: Change this to a random secret string in production!
PIN_PEPPER=change_me_to_a_random_secret_string_in_production

# File Constraints
MAX_FILE_SIZE_MB=25
PRESIGNED_URL_EXPIRY_SECONDS=300

# Brute Force Protection
BRUTE_FORCE_MAX_ATTEMPTS=5
BRUTE_FORCE_LOCKOUT_MINUTES=15
